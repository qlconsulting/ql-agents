{
  "version": 1,
  "app_type": "saas_dashboard",
  "app_name": "QL Agents",
  "api_contract": [
    {
      "method": "GET",
      "path": "/api/metrics",
      "response": "[{deployments,timeSaved,usage}]",
      "description": "Returns key deployment and usage metrics"
    },
    {
      "method": "GET",
      "path": "/api/agents",
      "response": "[{id,name,status,type,lastDeployed}]",
      "description": "List all tailored agents"
    },
    {
      "method": "POST",
      "path": "/api/agents",
      "response": "{id,name,status,type,createdAt}",
      "description": "Create a new tailored agent"
    },
    {
      "method": "GET",
      "path": "/api/agents/{id}",
      "response": "{id,name,type,tools,knowledge,deploymentHistory}",
      "description": "Get agent details"
    },
    {
      "method": "PUT",
      "path": "/api/agents/{id}",
      "response": "{id,name,type,tools,knowledge,updatedAt}",
      "description": "Update an agent configuration"
    },
    {
      "method": "DELETE",
      "path": "/api/agents/{id}",
      "response": "{deleted:true}",
      "description": "Delete an agent"
    },
    {
      "method": "GET",
      "path": "/api/knowledge",
      "response": "[{id,source,type,lastUpdated}]",
      "description": "List knowledge sources"
    },
    {
      "method": "POST",
      "path": "/api/deployments",
      "response": "{id,agentId,status,startedAt,endedAt}",
      "description": "Deploy a tailored agent"
    }
  ],
  "frontend_endpoints": [
    "/api/agents",
    "/api/agents/*",
    "/api/c/*/auth/*",
    "/api/c/*/auth/me",
    "/api/deployments",
    "/api/knowledge",
    "/api/metrics"
  ],
  "backend_endpoints": [
    "/api/agents",
    "/api/agents/*",
    "/api/ai/complete",
    "/api/chart-data",
    "/api/checkout",
    "/api/deployments",
    "/api/info",
    "/api/knowledge",
    "/api/metrics",
    "/api/portal",
    "/api/recent-activity",
    "/api/stats",
    "/api/subscription",
    "/api/webhook",
    "/health"
  ],
  "components": [],
  "known_issues": [],
